<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <!-- App Info -->
        <key>CFBundleDevelopmentRegion</key>
        <string>$(DEVELOPMENT_LANGUAGE)</string>
        <key>CFBundleDisplayName</key>
        <string>Farmer Brand</string>
        <key>CFBundleExecutable</key>
        <string>$(EXECUTABLE_NAME)</string>
        <key>CFBundleIdentifier</key>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <key>CFBundleInfoDictionaryVersion</key>
        <string>6.0</string>
        <key>CFBundleName</key>
        <string>farmer_brand</string>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleShortVersionString</key>
        <string>$(FLUTTER_BUILD_NAME)</string>
        <key>CFBundleVersion</key>
        <string>$(FLUTTER_BUILD_NUMBER)</string>
        <key>LSRequiresIPhoneOS</key>
        <true/>

        <!-- Launching -->
        <key>UILaunchStoryboardName</key>
        <string>LaunchScreen</string>
        <key>UIMainStoryboardFile</key>
        <string>Main</string>

        <!-- Orientation -->
        <key>UISupportedInterfaceOrientations</key>
        <array>
            <string>UIInterfaceOrientationPortrait</string>
            <string>UIInterfaceOrientationLandscapeLeft</string>
            <string>UIInterfaceOrientationLandscapeRight</string>
        </array>
        <key>UISupportedInterfaceOrientations~ipad</key>
        <array>
            <string>UIInterfaceOrientationPortrait</string>
            <string>UIInterfaceOrientationPortraitUpsideDown</string>
            <string>UIInterfaceOrientationLandscapeLeft</string>
            <string>UIInterfaceOrientationLandscapeRight</string>
        </array>

        <!-- Performance -->
        <key>CADisableMinimumFrameDurationOnPhone</key>
        <true/>
        <key>UIApplicationSupportsIndirectInputEvents</key>
        <true/>

        <!-- Permissions -->
        <key>NSAppleMusicUsageDescription</key>
        <string>We need access to your music library.</string>
        <key>NSMicrophoneUsageDescription</key>
        <string>This app requires microphone access.</string>
        <key>NSMediaLibraryUsageDescription</key>
        <string>Allow access to your media library.</string>
        <key>NSCameraUsageDescription</key>
        <string>This app requires camera access.</string>
        <key>NSPhotoLibraryUsageDescription</key>
        <string>This app needs photo library access.</string>
        <key>NSLocationWhenInUseUsageDescription</key>
        <string>Shows your location on the map and provides directions.</string>

        <!-- Background modes -->
        <key>UIBackgroundModes</key>
        <array>
            <string>audio</string>
            <string>location</string>
        </array>

        <!-- Network -->
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsArbitraryLoads</key>
            <true/>
        </dict>

        <!-- URL Schemes (Google Sign-In, UPI, etc.) -->
        <key>CFBundleURLTypes</key>
        <array>
            <dict>
                <key>CFBundleTypeRole</key>
                <string>Editor</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <!-- Google Sign-In reversed client ID -->
                    <string>com.googleusercontent.apps.647911492340-8p24g2n6m4tb44glnmiaafil5saa584f</string>
                    <!-- iOS Client ID scheme -->
                    <string>app-1-647911492340-ios-361b44edabac662aa5eca1</string>
                </array>
            </dict>
        </array>

        <key>GIDClientID</key>
        <string>647911492340-8p24g2n6m4tb44glnmiaafil5saa584f.apps.googleusercontent.com</string>

        <!-- App-to-App Payment Schemes -->
        <key>LSApplicationQueriesSchemes</key>
        <array>
            <string>upi</string>
            <string>tez</string>
            <string>paytm</string>
            <string>phonepe</string>
            <string>credpay</string>
            <string>bhim</string>
        </array>


    </dict>
</plist>
